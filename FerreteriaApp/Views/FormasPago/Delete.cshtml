@model FormaPago
@{
    ViewData["Title"] = "Eliminar forma de pago";
}

<div class="form-auth">
    <div class="card shadow-sm border-danger">
        <div class="card-body p-4 text-center">
            <i class="bi bi-trash text-danger" style="font-size: 3rem;"></i>
            <h3 class="mt-2">¿Eliminar esta forma de pago?</h3>
            <h4>@Model.Nombre</h4>
            <p class="text-muted">@Model.Descripcion</p>
            @if (Model.Ventas.Count > 0)
            {
                <div class="alert alert-warning small">
                    Se usó en <strong>@Model.Ventas.Count</strong> venta(s), así que <strong>se desactivará</strong> en lugar de eliminarse.
                </div>
            }
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="IdFormaPago" />
                <button type="submit" class="btn btn-danger">Sí, @(Model.Ventas.Count > 0 ? "desactivar" : "eliminar")</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>
